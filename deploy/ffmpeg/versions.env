# What goes into the Windows ffmpeg (deploy/ffmpeg/build.sh). Every source is
# pinned by SHA-256; a hash mismatch stops the build. BUILD counts rebuilds of
# the same FFmpeg version (new dependency pins, new flags) and is part of the
# release tag, ffmpeg-<FFMPEG_VERSION>-<BUILD>.
FFMPEG_VERSION=8.1.3
BUILD=1
FFMPEG_SHA256=7138d28c96d9d3e3af4ee3d8cad72741f8ffb40da90c1112235dea3ecd3178a3

# x264's stable branch (GPL v2+); libx264 for CPU encoding.
X264_COMMIT=b35605ace3ddf7c1a5d67a2eb553f034aef41d55
X264_SHA256=6eeb82934e69fd51e043bd8c5b0d152839638d1ce7aa4eea65a3fedcf83ff224

# z.lib (WTFPL): the zscale filter, used to tone map HDR on the CPU.
ZIMG_VERSION=3.0.6
ZIMG_SHA256=be89390f13a5c9b2388ce0f44a5e89364a20c1c57ce46d382b1fcc3967057577

# libwebp (BSD-3): posters and stills.
LIBWEBP_VERSION=1.6.0
LIBWEBP_SHA256=e4ab7009bf0629fd11982d4c2aa83964cf244cffba7347ecd39019a9e38c4564

# Intel VPL dispatcher (MIT): Quick Sync (h264_qsv, -hwaccel qsv).
LIBVPL_VERSION=2.17.0
LIBVPL_SHA256=4de3e2faf1e8307fb282e4a43f443191810f6a6b0a484fffa7995ba1c814c6ec

# NVIDIA codec headers (MIT): NVENC, NVDEC and the CUDA filters. The header
# version sets the oldest driver NVENC runs on (Windows): 12.1 needs 531.61,
# 12.2 needs 551.76, 13.0 needs 570, 13.1 needs 610. 12.1 is the oldest
# FFmpeg 8.1 accepts, and it has everything Couchside uses.
NVCODEC_VERSION=12.1.14.0
NVCODEC_SHA256=2fefaa227d2a3b4170797796425a59d1dd2ed5fd231db9b4244468ba327acd0b

# Khronos OpenCL headers and ICD loader (Apache-2.0): tonemap_opencl on
# NVIDIA, which has no CUDA tone mapping in stock FFmpeg.
OPENCL_VERSION=2025.07.22
OPENCL_HEADERS_SHA256=98f0a3ea26b4aec051e533cb1750db2998ab8e82eda97269ed6efe66ec94a240
OPENCL_LOADER_SHA256=dff7a0b11ad5b63a669358e3476e3dc889a4a361674e5b69b267b944d0794142

# zlib (zlib licence): PNG covers in Matroska attachments, compressed headers.
ZLIB_VERSION=1.3.1
ZLIB_SHA256=9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23
