# Metadata. Release images have Couchside's own TMDB key built in; set this to
# use yours (https://www.themoviedb.org/settings/api), or "off" to disable TMDB.
TMDB_API_KEY=
# Optional fallback: OMDb key from https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# NAS login that can read (and, to record into it, write) the media share.
# Avoid commas in the password; they break the SMB mount options.
NAS_USER=
NAS_PASSWORD=
NAS_HOST=nas.local
NAS_SHARE=Video

# Accounts: true = every profile signs in with a password
COUCHSIDE_AUTH=false

# Live TV + DVR: HDHomeRun IP address (leave empty to disable)
HDHOMERUN=
TZ=America/New_York
