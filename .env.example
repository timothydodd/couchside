# Release to run, e.g. 0.19.0; empty follows the latest.
COUCHSIDE_VERSION=

# docker-compose.yml: the folder with your media (docker-compose.smb.yml ignores it).
MEDIA_PATH=./media

# Metadata. Release images have Couchside's own TMDB key built in; set this to
# use yours (https://www.themoviedb.org/settings/api), or "off" to disable TMDB.
TMDB_API_KEY=
# Optional fallback: OMDb key from https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# true = require passwords (no passwordless sign-in); for servers on the internet
COUCHSIDE_AUTH=false

# Hardware encoding: none, or vaapi on a Linux host with an Intel or AMD GPU
# (also uncomment "devices" in the compose file)
COUCHSIDE_HWACCEL=none

# Live TV + DVR: HDHomeRun IP address (leave empty to disable)
HDHOMERUN=
# Time zone for guide times and recording names, e.g. America/New_York; empty = UTC.
TZ=

# docker-compose.smb.yml only: a NAS login that can read (and, to record into
# it, write) the media share. Avoid commas in the password; they break the
# SMB mount options.
NAS_USER=
NAS_PASSWORD=
NAS_HOST=nas.local
NAS_SHARE=Video
